<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.edu.utfpr.sd.garagem.client.ui.RegisterController">
    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="14">
            <StackPane styleClass="logo-badge">
                <Label text="P" styleClass="logo-badge-text"/>
            </StackPane>
            <VBox spacing="4">
                <Label text="SD Garagem" styleClass="app-title-on-dark"/>
                <Label text="Criar conta" styleClass="app-subtitle-on-dark"/>
            </VBox>
        </HBox>
    </top>
    <center>
        <StackPane>
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>
            <VBox styleClass="card" maxWidth="380" maxHeight="-Infinity" spacing="18">
                <padding>
                    <Insets top="28" right="32" bottom="28" left="32"/>
                </padding>
                <Label text="Cadastrar" styleClass="card-title"/>
                <GridPane hgap="10" vgap="4">
                    <columnConstraints>
                        <ColumnConstraints minWidth="110"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="Usuario" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="usernameField" maxWidth="Infinity" promptText="Usuario" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label fx:id="usernameLengthHint" wrapText="true" styleClass="hint-invalid"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Label fx:id="usernameCharsetHint" wrapText="true" styleClass="hint-invalid"
                           GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    <Label text="Senha" styleClass="field-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <PasswordField fx:id="passwordField" maxWidth="Infinity" promptText="Senha" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    <Label fx:id="passwordLengthHint" wrapText="true" styleClass="hint-invalid"
                           GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                    <Label fx:id="passwordCharsetHint" wrapText="true" styleClass="hint-invalid"
                           GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                    <Label text="Confirmar senha" styleClass="field-label" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                    <PasswordField fx:id="confirmPasswordField" maxWidth="Infinity" promptText="Senha" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                    <Label fx:id="confirmPasswordHint" wrapText="true" styleClass="hint-invalid"
                           GridPane.rowIndex="7" GridPane.columnIndex="1"/>
                </GridPane>
                <VBox spacing="8">
                    <HBox alignment="CENTER">
                        <Button fx:id="registerButton" text="Cadastrar" onAction="#handleRegister" disable="true"
                                defaultButton="true" styleClass="button-primary"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER">
                        <ProgressIndicator fx:id="progressIndicator" visible="false" managed="false" prefWidth="18" prefHeight="18"/>
                        <Label fx:id="statusLabel" wrapText="true" textAlignment="CENTER" styleClass="status-label"/>
                    </HBox>
                    <Hyperlink text="Voltar para o login" onAction="#handleBackToLogin" alignment="CENTER" maxWidth="Infinity"/>
                </VBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
