<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.edu.utfpr.sd.garagem.client.ui.MainController">
    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="14">
            <StackPane styleClass="logo-badge">
                <Label text="P" styleClass="logo-badge-text"/>
            </StackPane>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="SD Garagem" styleClass="app-title-on-dark"/>
                <Label text="Rastreador de Ocupacao de Garagens de Estacionamento" styleClass="app-subtitle-on-dark"/>
            </VBox>
            <Button fx:id="profileButton" onAction="#handleOpenProfile" styleClass="button-secondary-on-dark"
                    prefWidth="36" prefHeight="36" contentDisplay="GRAPHIC_ONLY">
                <graphic>
                    <SVGPath fill="white"
                             content="M8 8c2.21 0 4-1.79 4-4S10.21 0 8 0 4 1.79 4 4s1.79 4 4 4zm0 2C5.33 10 0 11.34 0 14v2h16v-2c0-2.66-5.33-4-8-4z"/>
                </graphic>
                <tooltip><Tooltip text="Meu perfil"/></tooltip>
            </Button>
            <Button fx:id="logoutButton" text="Sair" onAction="#handleLogout" styleClass="button-secondary-on-dark"
                    minWidth="60"/>
        </HBox>
    </top>
    <center>
        <VBox styleClass="page-bg" spacing="0" maxWidth="Infinity" maxHeight="Infinity">
            <padding><Insets top="20" right="20" bottom="16" left="20"/></padding>

            <!-- barra de boas-vindas -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <padding><Insets bottom="14"/></padding>
                <Label fx:id="usernameLabel" styleClass="card-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="roleLabel" styleClass="role-pill"/>
            </HBox>

            <!-- card principal com as abas -->
            <VBox VBox.vgrow="ALWAYS" styleClass="main-card" maxWidth="Infinity" maxHeight="Infinity" spacing="0">

                <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" maxWidth="Infinity" maxHeight="Infinity">

                    <!-- TAB VAGAS -->
                    <Tab fx:id="vagasTab" text="Vagas">
                        <VBox spacing="10" maxWidth="Infinity" maxHeight="Infinity">
                            <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>

                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Button fx:id="refreshVagasButton" text="↺" onAction="#handleRefreshVagas"
                                        styleClass="button-reload">
                                    <tooltip><Tooltip text="Atualizar lista de vagas"/></tooltip>
                                </Button>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="updateVagaButton" onAction="#handleUpdateVaga"
                                        disable="true" styleClass="button-icon-edit"
                                        managed="false" visible="false" contentDisplay="GRAPHIC_ONLY">
                                    <graphic><SVGPath fill="#55607A" content="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></graphic>
                                    <tooltip><Tooltip text="Editar vaga selecionada"/></tooltip>
                                </Button>
                                <Button fx:id="deleteVagaButton" onAction="#handleDeleteVaga"
                                        disable="true" styleClass="button-icon-delete"
                                        managed="false" visible="false" contentDisplay="GRAPHIC_ONLY">
                                    <graphic><SVGPath fill="#C23B3B" content="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></graphic>
                                    <tooltip><Tooltip text="Remover vaga selecionada"/></tooltip>
                                </Button>
                                <Button fx:id="createVagaButton" text="+ Nova vaga" onAction="#handleCreateVaga"
                                        styleClass="button-primary" managed="false" visible="false"/>
                            </HBox>

                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="Localizar placa:" styleClass="field-label"/>
                                <TextField fx:id="findPlateField" promptText="Ex: ABC1234" prefWidth="140"/>
                                <Button text="Buscar" onAction="#handleFindVehicle" styleClass="button-secondary"/>
                                <Label fx:id="findVehicleResult" wrapText="true" styleClass="status-label" HBox.hgrow="ALWAYS"/>
                            </HBox>

                            <TableView fx:id="vagasTable" VBox.vgrow="ALWAYS" maxWidth="Infinity" maxHeight="Infinity">
                                <columns>
                                    <TableColumn fx:id="vagaSpotNameCol" text="Vaga"   prefWidth="80"/>
                                    <TableColumn fx:id="vagaFloorCol"    text="Andar"  prefWidth="70"/>
                                    <TableColumn fx:id="vagaTypeCol"     text="Tipo"   prefWidth="100"/>
                                    <TableColumn fx:id="vagaStatusCol"   text="Status" prefWidth="130"/>
                                    <TableColumn fx:id="vagaPlateCol"    text="Placa"  prefWidth="120"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </Tab>

                    <!-- TAB VEÍCULOS -->
                    <Tab fx:id="veiculosTab" text="Meus Veículos">
                        <VBox spacing="10" maxWidth="Infinity" maxHeight="Infinity">
                            <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>

                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Button fx:id="refreshVehiclesButton" text="↺" onAction="#handleRefreshVehicles"
                                        styleClass="button-reload">
                                    <tooltip><Tooltip text="Atualizar lista de veículos"/></tooltip>
                                </Button>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="editVehicleButton" onAction="#handleEditVehicle"
                                        disable="true" styleClass="button-icon-edit" contentDisplay="GRAPHIC_ONLY">
                                    <graphic><SVGPath fill="#55607A" content="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></graphic>
                                    <tooltip><Tooltip text="Editar veículo selecionado"/></tooltip>
                                </Button>
                                <Button fx:id="deleteVehicleButton" onAction="#handleDeleteVehicle"
                                        disable="true" styleClass="button-icon-delete" contentDisplay="GRAPHIC_ONLY">
                                    <graphic><SVGPath fill="#C23B3B" content="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></graphic>
                                    <tooltip><Tooltip text="Remover veículo selecionado"/></tooltip>
                                </Button>
                                <Button text="+ Cadastrar veículo" onAction="#handleCreateVehicle"
                                        styleClass="button-primary"/>
                            </HBox>

                            <TableView fx:id="vehiclesTable" VBox.vgrow="ALWAYS" maxWidth="Infinity" maxHeight="Infinity">
                                <columns>
                                    <TableColumn fx:id="vehicleBrandCol" text="Marca"  prefWidth="120"/>
                                    <TableColumn fx:id="vehicleModelCol" text="Modelo" prefWidth="150"/>
                                    <TableColumn fx:id="vehicleTypeCol"  text="Tipo"   prefWidth="100"/>
                                    <TableColumn fx:id="vehiclePlateCol" text="Placa"  prefWidth="120"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </Tab>

                    <!-- TAB USUÁRIOS (admin) -->
                    <Tab fx:id="usuariosTab" text="Usuarios">
                        <VBox spacing="10" maxWidth="Infinity" maxHeight="Infinity">
                            <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>

                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Button text="↺" onAction="#handleRefreshUsers" styleClass="button-reload">
                                    <tooltip><Tooltip text="Atualizar lista de usuários"/></tooltip>
                                </Button>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="editUserButton" onAction="#handleEditUser"
                                        disable="true" styleClass="button-icon-edit" contentDisplay="GRAPHIC_ONLY">
                                    <graphic><SVGPath fill="#55607A" content="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></graphic>
                                    <tooltip><Tooltip text="Editar nome do usuário selecionado"/></tooltip>
                                </Button>
                                <Button fx:id="deleteUserAdminButton" onAction="#handleDeleteUserAdmin"
                                        disable="true" styleClass="button-icon-delete" contentDisplay="GRAPHIC_ONLY">
                                    <graphic><SVGPath fill="#C23B3B" content="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></graphic>
                                    <tooltip><Tooltip text="Deletar usuário selecionado"/></tooltip>
                                </Button>
                                <Button text="+ Criar usuário" onAction="#handleCreateUser" styleClass="button-primary"/>
                            </HBox>

                            <TextField fx:id="userSearchField" promptText="Buscar por nome ou username..."
                                       maxWidth="Infinity"/>

                            <TableView fx:id="usersTable" VBox.vgrow="ALWAYS" maxWidth="Infinity" maxHeight="Infinity">
                                <columns>
                                    <TableColumn fx:id="userUsernameCol" text="Usuário" prefWidth="160"/>
                                    <TableColumn fx:id="userNameCol"     text="Nome"    prefWidth="220"/>
                                    <TableColumn fx:id="userRoleCol"     text="Papel"   prefWidth="100"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </Tab>

                </TabPane>

            </VBox>

            <!-- barra de status -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <padding><Insets top="10"/></padding>
                <ProgressIndicator fx:id="progressIndicator" visible="false" managed="false" prefWidth="16" prefHeight="16"/>
                <Label fx:id="statusLabel" wrapText="true" styleClass="status-label"/>
            </HBox>

        </VBox>
    </center>
</BorderPane>
