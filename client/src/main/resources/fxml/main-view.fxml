<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.edu.utfpr.sd.garagem.client.ui.MainController">
    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="14">
            <StackPane styleClass="logo-badge">
                <Label text="P" styleClass="logo-badge-text"/>
            </StackPane>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="SD Garagem" styleClass="app-title-on-dark"/>
                <Label text="Rastreador de Ocupacao de Garagens de Estacionamento" styleClass="app-subtitle-on-dark" wrapText="true"/>
            </VBox>
            <Button fx:id="profileButton" onAction="#handleOpenProfile" styleClass="button-secondary-on-dark"
                    minWidth="40" prefWidth="40" contentDisplay="GRAPHIC_ONLY">
                <graphic>
                    <SVGPath fill="white"
                             content="M8 8c2.21 0 4-1.79 4-4S10.21 0 8 0 4 1.79 4 4s1.79 4 4 4zm0 2C5.33 10 0 11.34 0 14v2h16v-2c0-2.66-5.33-4-8-4z"/>
                </graphic>
                <tooltip><Tooltip text="Meu perfil"/></tooltip>
            </Button>
            <Button fx:id="logoutButton" text="Sair" onAction="#handleLogout" styleClass="button-secondary-on-dark"
                    minWidth="70"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="0">
            <padding>
                <Insets top="16" right="16" bottom="12" left="16"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <padding><Insets bottom="10"/></padding>
                <Label fx:id="usernameLabel" styleClass="card-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="roleLabel" styleClass="status-label"/>
            </HBox>

            <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

                <!-- TAB VAGAS (todos) -->
                <Tab fx:id="vagasTab" text="Vagas">
                    <VBox spacing="8">
                        <padding><Insets top="10" right="4" bottom="4" left="4"/></padding>

                        <!-- barra de ações -->
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Button fx:id="refreshVagasButton" text="Atualizar" onAction="#handleRefreshVagas"
                                    styleClass="button-secondary"/>
                            <Button fx:id="updateVagaButton" text="Editar selecionada" onAction="#handleUpdateVaga"
                                    disable="true" styleClass="button-secondary"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="createVagaButton" text="+ Nova vaga" onAction="#handleCreateVaga"
                                    styleClass="button-primary" managed="false" visible="false"/>
                            <Button fx:id="deleteVagaButton" text="Remover vaga" onAction="#handleDeleteVaga"
                                    disable="true" styleClass="button-danger" managed="false" visible="false"/>
                        </HBox>

                        <!-- busca por placa -->
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="Localizar placa:" styleClass="field-label"/>
                            <TextField fx:id="findPlateField" promptText="Ex: ABC1234" prefWidth="140"/>
                            <Button text="Buscar" onAction="#handleFindVehicle" styleClass="button-secondary"/>
                            <Label fx:id="findVehicleResult" wrapText="true" styleClass="status-label"/>
                        </HBox>

                        <Separator/>

                        <TableView fx:id="vagasTable" VBox.vgrow="ALWAYS" minHeight="200">
                            <columns>
                                <TableColumn fx:id="vagaSpotNameCol" text="Vaga" prefWidth="80"/>
                                <TableColumn fx:id="vagaFloorCol" text="Andar" prefWidth="60"/>
                                <TableColumn fx:id="vagaTypeCol" text="Tipo" prefWidth="90"/>
                                <TableColumn fx:id="vagaStatusCol" text="Status" prefWidth="120"/>
                                <TableColumn fx:id="vagaPlateCol" text="Placa" prefWidth="100"/>
                            </columns>
                        </TableView>
                    </VBox>
                </Tab>

                <!-- TAB VEÍCULOS (usuário comum) -->
                <Tab fx:id="veiculosTab" text="Meus Veículos">
                    <VBox spacing="8">
                        <padding><Insets top="10" right="4" bottom="4" left="4"/></padding>

                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Button fx:id="refreshVehiclesButton" text="Atualizar" onAction="#handleRefreshVehicles"
                                    styleClass="button-secondary"/>
                            <Button fx:id="editVehicleButton" text="Editar selecionado" onAction="#handleEditVehicle"
                                    disable="true" styleClass="button-secondary"/>
                            <Button fx:id="deleteVehicleButton" text="Remover selecionado" onAction="#handleDeleteVehicle"
                                    disable="true" styleClass="button-danger"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="+ Cadastrar veículo" onAction="#handleCreateVehicle"
                                    styleClass="button-primary"/>
                        </HBox>

                        <Separator/>

                        <TableView fx:id="vehiclesTable" VBox.vgrow="ALWAYS" minHeight="200">
                            <columns>
                                <TableColumn fx:id="vehicleBrandCol" text="Marca" prefWidth="100"/>
                                <TableColumn fx:id="vehicleModelCol" text="Modelo" prefWidth="120"/>
                                <TableColumn fx:id="vehicleTypeCol" text="Tipo" prefWidth="90"/>
                                <TableColumn fx:id="vehiclePlateCol" text="Placa" prefWidth="100"/>
                            </columns>
                        </TableView>
                    </VBox>
                </Tab>

                <!-- TAB USUÁRIOS (admin) -->
                <Tab fx:id="usuariosTab" text="Usuarios">
                    <VBox spacing="8">
                        <padding><Insets top="10" right="4" bottom="4" left="4"/></padding>

                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Button text="Atualizar" onAction="#handleRefreshUsers" styleClass="button-secondary"/>
                            <Button fx:id="editUserButton" text="Editar nome" onAction="#handleEditUser"
                                    disable="true" styleClass="button-secondary"/>
                            <Button fx:id="deleteUserAdminButton" text="Deletar usuário" onAction="#handleDeleteUserAdmin"
                                    disable="true" styleClass="button-danger"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="+ Criar usuário" onAction="#handleCreateUser" styleClass="button-primary"/>
                        </HBox>

                        <Separator/>

                        <TableView fx:id="usersTable" VBox.vgrow="ALWAYS" minHeight="200">
                            <columns>
                                <TableColumn fx:id="userUsernameCol" text="Usuario" prefWidth="130"/>
                                <TableColumn fx:id="userNameCol" text="Nome" prefWidth="160"/>
                                <TableColumn fx:id="userRoleCol" text="Papel" prefWidth="80"/>
                            </columns>
                        </TableView>
                    </VBox>
                </Tab>

            </TabPane>

            <HBox spacing="8" alignment="CENTER_LEFT">
                <padding><Insets top="8"/></padding>
                <ProgressIndicator fx:id="progressIndicator" visible="false" managed="false" prefWidth="16" prefHeight="16"/>
                <Label fx:id="statusLabel" wrapText="true" styleClass="status-label"/>
            </HBox>

        </VBox>
    </center>
</BorderPane>
