<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.edu.utfpr.sd.garagem.client.ui.MainController">
    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="14">
            <StackPane styleClass="logo-badge">
                <Label text="P" styleClass="logo-badge-text"/>
            </StackPane>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="SD Garagem" styleClass="app-title-on-dark"/>
                <Label text="Rastreador de Ocupacao de Garagens de Estacionamento" styleClass="app-subtitle-on-dark" wrapText="true"/>
            </VBox>
            <Button fx:id="profileButton" onAction="#handleOpenProfile" styleClass="button-secondary-on-dark"
                    minWidth="40" prefWidth="40" contentDisplay="GRAPHIC_ONLY">
                <graphic>
                    <SVGPath fill="white"
                             content="M8 8c2.21 0 4-1.79 4-4S10.21 0 8 0 4 1.79 4 4s1.79 4 4 4zm0 2C5.33 10 0 11.34 0 14v2h16v-2c0-2.66-5.33-4-8-4z"/>
                </graphic>
                <tooltip><Tooltip text="Meu perfil"/></tooltip>
            </Button>
            <Button fx:id="logoutButton" text="Sair" onAction="#handleLogout" styleClass="button-secondary-on-dark"
                    minWidth="70"/>
        </HBox>
    </top>
    <center>
        <StackPane>
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>
            <VBox styleClass="card" maxWidth="440" maxHeight="-Infinity" spacing="14">
                <padding>
                    <Insets top="26" right="30" bottom="26" left="30"/>
                </padding>
                <Label fx:id="usernameLabel" styleClass="card-title" wrapText="true"/>
                <Separator/>
                <!-- TODO EP-2: substituir esta nota por um painel real de
                     vagas disponiveis por andar, atualizado em tempo real. -->
                <Label text="O painel de vagas disponiveis por andar chega na proxima entrega (EP-2)."
                       wrapText="true" styleClass="placeholder-note"/>
                <Label fx:id="statusLabel" wrapText="true" styleClass="status-label"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
