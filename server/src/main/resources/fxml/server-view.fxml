<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.edu.utfpr.sd.garagem.server.ui.ServerController">
    <top>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Porta:"/>
                <TextField fx:id="portField" prefWidth="80"/>
                <Button fx:id="startButton" text="Iniciar" onAction="#handleStart"/>
                <Button fx:id="stopButton" text="Parar" onAction="#handleStop"/>
                <Label text="Status:"/>
                <Label fx:id="statusLabel" text="Parado"/>
            </HBox>
            <HBox spacing="20" alignment="CENTER_LEFT">
                <Label fx:id="connectedClientsLabel" text="Clientes conectados: 0"/>
                <Label fx:id="activeSessionsLabel" text="Sessoes ativas: 0"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <TextArea fx:id="logArea" editable="false" wrapText="true"/>
    </center>
</BorderPane>
