<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.edu.utfpr.sd.garagem.server.ui.ServerController">
    <fx:define>
        <!-- Fora do <tooltip> do badge de proposito: exibida/escondida na mao pelo
             controller (ancorada abaixo do badge), para nao sobrepor o cursor e
             entrar em loop de mostra/esconde (bug corrigido nesta versao). -->
        <Tooltip fx:id="statusCodeTooltip" styleClass="status-code-tooltip">
            <graphic>
                <VBox spacing="10">
                    <Label text="CODIGOS DE STATUS MAIS COMUNS" styleClass="tooltip-title"/>
                    <Region styleClass="tooltip-divider"/>
                    <VBox spacing="7">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Region styleClass="status-dot, status-dot-ok"/>
                            <Label text="200" styleClass="tooltip-code"/>
                            <Label text="OK — sucesso" styleClass="tooltip-desc"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Region styleClass="status-dot, status-dot-warn"/>
                            <Label text="400" styleClass="tooltip-code"/>
                            <Label text="Bad Request — requisicao malformada ou dados invalidos" styleClass="tooltip-desc"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Region styleClass="status-dot, status-dot-warn"/>
                            <Label text="401" styleClass="tooltip-code"/>
                            <Label text="Unauthorized — credenciais ou token invalidos/expirados" styleClass="tooltip-desc"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Region styleClass="status-dot, status-dot-warn"/>
                            <Label text="404" styleClass="tooltip-code"/>
                            <Label text="Not Found — operacao (method) nao suportada" styleClass="tooltip-desc"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Region styleClass="status-dot, status-dot-warn"/>
                            <Label text="409" styleClass="tooltip-code"/>
                            <Label text="Conflict — usuario ja cadastrado" styleClass="tooltip-desc"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Region styleClass="status-dot, status-dot-error"/>
                            <Label text="500" styleClass="tooltip-code"/>
                            <Label text="Internal Error — erro inesperado no servidor" styleClass="tooltip-desc"/>
                        </HBox>
                    </VBox>
                </VBox>
            </graphic>
        </Tooltip>
    </fx:define>
    <top>
        <VBox>
            <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="14">
                <StackPane styleClass="logo-badge">
                    <Label text="P" styleClass="logo-badge-text"/>
                </StackPane>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="SD Garagem" styleClass="app-title-on-dark"/>
                    <Label text="Painel do Servidor" styleClass="app-subtitle-on-dark"/>
                </VBox>
                <Label fx:id="statusLabel" text="Parado" styleClass="status-pill-offline"/>
            </HBox>
            <FlowPane styleClass="toolbar" hgap="10" vgap="8" alignment="CENTER_LEFT">
                <Label text="Porta:" styleClass="field-label"/>
                <TextField fx:id="portField" prefWidth="80"/>
                <Button fx:id="startButton" text="Iniciar" onAction="#handleStart" defaultButton="true" styleClass="button-primary"/>
                <Button fx:id="stopButton" text="Parar" onAction="#handleStop" styleClass="button-secondary"/>
                <Button fx:id="logoutAllButton" text="Encerrar todas as sessões" onAction="#handleLogoutAll" styleClass="button-danger"/>
            </FlowPane>
            <FlowPane styleClass="stats-bar" hgap="14" vgap="10">
                <VBox styleClass="stat-tile" spacing="2">
                    <Label text="CLIENTES CONECTADOS" styleClass="stat-tile-label"/>
                    <Label fx:id="connectedClientsLabel" text="0" styleClass="stat-tile-value"/>
                </VBox>
                <VBox styleClass="stat-tile" spacing="2">
                    <Label text="SESSOES ATIVAS" styleClass="stat-tile-label"/>
                    <Label fx:id="activeSessionsLabel" text="0" styleClass="stat-tile-value"/>
                </VBox>
            </FlowPane>
        </VBox>
    </top>
    <center>
        <VBox spacing="8">
            <padding>
                <Insets top="16" right="24" bottom="16" left="24"/>
            </padding>
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Label text="Log do protocolo" styleClass="section-title"/>
                <Label fx:id="statusCodeHelpBadge" text="?" styleClass="help-badge"/>
            </HBox>
            <TextArea fx:id="logArea" editable="false" wrapText="true" styleClass="log-area" VBox.vgrow="ALWAYS"/>
        </VBox>
    </center>
</BorderPane>
